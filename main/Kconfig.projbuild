menu "PPM-MC-IOT App Config"

config PPM_IOT_CENTRAL_URL
	string "PPM IoT Central api url"
	help
		URL to the IoT central web service for device config

config PPM_IOT_CENTRAL_SECRET
	string "PPM IoT Central secret key"
	help
		Secret key to access the IoT Central web service api				
			
menu Button
	config IOT_BUTTON_ENABLE
		bool "Enable Button"
		default y
		help
			Select to enable button

	config BUTTON_USE_ESP_TIMER
		bool "Use ESP Timer"
		default y
		
	config IO_GLITCH_FILTER_TIME_MS
		int "IO glitch filter timer ms (10~100)"
		default 50
		help
			Please enter a decimal value. Fractions will not be accepted.  
			Use the <TAB> key to move from the input field to the buttons below it. 

	config IOT_DEBUG_ENABLE
		bool "Enable IoT Debug"	

	config IOT_LED_ENABLE
		bool "Enable LED for Button"
		default y

endmenu

endmenu
